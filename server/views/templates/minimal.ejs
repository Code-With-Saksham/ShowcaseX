<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= p.personal?.fullName || 'Portfolio' %> | Developer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --accent: <%= p.customTheme?.accentColor || '#eb3237' %>;
      --bg: <%= p.customTheme?.darkTheme ? '#0a0a0a' : '#f8fafc' %>;
      --card-bg: <%= p.customTheme?.darkTheme ? '#18181b' : '#ffffff' %>;
      --text: <%= p.customTheme?.darkTheme ? '#f1f5f9' : '#0f172a' %>;
      --text-muted: <%= p.customTheme?.darkTheme ? '#94a3b8' : '#64748b' %>;
      --border: <%= p.customTheme?.darkTheme ? '#27272a' : '#e2e8f0' %>;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Inter', sans-serif; }
    body { background-color: var(--bg); color: var(--text); line-height: 1.6; padding: 0 1.5rem; transition: all 0.3s ease; }
    .container { max-width: 900px; margin: 0 auto; padding: 4rem 0; }
    header { text-align: center; margin-bottom: 4rem; }
    .profile-img { width: 120px; height: 120px; border-radius: 50%; object-fit: cover; border: 3px solid var(--accent); margin-bottom: 1.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
    h1 { font-size: 2.5rem; font-weight: 700; margin-bottom: 0.5rem; letter-spacing: -0.02em; }
    .tagline { color: var(--accent); font-size: 1.25rem; font-weight: 500; margin-bottom: 1rem; }
    .bio { color: var(--text-muted); max-width: 600px; margin: 0 auto 1.5rem; font-size: 1rem; }
    .socials { display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; }
    .social-btn { padding: 0.5rem 1.2rem; border-radius: 20px; background: var(--card-bg); color: var(--text); text-decoration: none; border: 1px solid var(--border); font-size: 0.9rem; font-weight: 500; transition: all 0.2s; }
    .social-btn:hover { border-color: var(--accent); color: var(--accent); transform: translateY(-2px); }

    section { margin-bottom: 3.5rem; }
    h2 { font-size: 1.5rem; font-weight: 600; margin-bottom: 1.5rem; border-bottom: 2px solid var(--border); padding-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem; }
    
    .skills-grid { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .skill-chip { padding: 0.5rem 1rem; background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; font-size: 0.9rem; font-weight: 500; display: flex; align-items: center; gap: 0.5rem; }
    .skill-level { font-size: 0.75rem; color: var(--accent); background: rgba(99,102,241,0.1); padding: 0.15rem 0.4rem; border-radius: 4px; }

    .projects-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
    .project-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; transition: transform 0.2s, border-color 0.2s; }
    .project-card:hover { transform: translateY(-4px); border-color: var(--accent); }
    .project-img { width: 100%; height: 160px; object-fit: cover; }
    .project-body { padding: 1.25rem; }
    .project-title { font-size: 1.15rem; font-weight: 600; margin-bottom: 0.5rem; }
    .project-desc { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1rem; }
    .tech-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 1rem; }
    .tech-tag { font-size: 0.75rem; padding: 0.2rem 0.5rem; background: var(--bg); border: 1px solid var(--border); border-radius: 4px; color: var(--text-muted); }
    .project-links { display: flex; gap: 1rem; font-size: 0.85rem; }
    .project-links a { color: var(--accent); text-decoration: none; font-weight: 500; }

    .timeline-item { position: relative; padding-left: 1.5rem; border-left: 2px solid var(--border); margin-bottom: 1.5rem; }
    .timeline-item::before { content: ''; position: absolute; left: -6px; top: 6px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
    .timeline-title { font-size: 1.1rem; font-weight: 600; }
    .timeline-subtitle { color: var(--accent); font-size: 0.9rem; font-weight: 500; margin-bottom: 0.25rem; }
    .timeline-date { color: var(--text-muted); font-size: 0.8rem; margin-bottom: 0.5rem; }
    .timeline-desc { color: var(--text-muted); font-size: 0.9rem; }

    footer { text-align: center; color: var(--text-muted); font-size: 0.85rem; border-top: 1px solid var(--border); padding-top: 2rem; margin-top: 4rem; }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <% if (p.personal?.profileImage) { %>
        <img src="<%= p.personal.profileImage %>" alt="<%= p.personal.fullName %>" class="profile-img">
      <% } %>
      <h1><%= p.personal?.fullName || 'Developer Portfolio' %></h1>
      <% if (p.personal?.tagline) { %>
        <div class="tagline"><%= p.personal.tagline %></div>
      <% } %>
      <% if (p.personal?.bio) { %>
        <p class="bio"><%= p.personal.bio %></p>
      <% } %>
      <div class="socials">
        <% if (p.social?.github) { %><a href="<%= p.social.github %>" target="_blank" class="social-btn">GitHub</a><% } %>
        <% if (p.social?.linkedin) { %><a href="<%= p.social.linkedin %>" target="_blank" class="social-btn">LinkedIn</a><% } %>
        <% if (p.social?.twitter) { %><a href="<%= p.social.twitter %>" target="_blank" class="social-btn">Twitter</a><% } %>
        <% if (p.social?.email) { %><a href="mailto:<%= p.social.email %>" class="social-btn">Email</a><% } %>
        <% if (p.personal?.resumeUrl) { %><a href="<%= p.personal.resumeUrl %>" target="_blank" class="social-btn" style="background: var(--accent); color: white;">Resume PDF</a><% } %>
      </div>
    </header>

    <% if (p.skills && p.skills.length > 0) { %>
    <section>
      <h2>Skills & Expertise</h2>
      <div class="skills-grid">
        <% p.skills.forEach(skill => { %>
          <div class="skill-chip">
            <span><%= skill.name %></span>
            <% if (skill.level) { %><span class="skill-level"><%= skill.level %></span><% } %>
          </div>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (p.projects && p.projects.length > 0) { %>
    <section>
      <h2>Featured Projects</h2>
      <div class="projects-grid">
        <% p.projects.forEach(project => { %>
          <div class="project-card">
            <% if (project.image) { %>
              <img src="<%= project.image %>" alt="<%= project.title %>" class="project-img">
            <% } %>
            <div class="project-body">
              <div class="project-title"><%= project.title %></div>
              <p class="project-desc"><%= project.description %></p>
              <% if (project.techStack && project.techStack.length > 0) { %>
                <div class="tech-tags">
                  <% project.techStack.forEach(t => { %>
                    <span class="tech-tag"><%= t %></span>
                  <% }) %>
                </div>
              <% } %>
              <div class="project-links">
                <% if (project.githubUrl) { %><a href="<%= project.githubUrl %>" target="_blank">Code →</a><% } %>
                <% if (project.liveUrl) { %><a href="<%= project.liveUrl %>" target="_blank">Live Demo →</a><% } %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
    <% } %>

    <% if (p.experience && p.experience.length > 0) { %>
    <section>
      <h2>Work Experience</h2>
      <% p.experience.forEach(exp => { %>
        <div class="timeline-item">
          <div class="timeline-title"><%= exp.role %></div>
          <div class="timeline-subtitle"><%= exp.company %> <% if (exp.location) { %> • <%= exp.location %><% } %></div>
          <div class="timeline-date"><%= exp.startDate %> - <%= exp.current ? 'Present' : exp.endDate %></div>
          <div class="timeline-desc"><%= exp.description %></div>
        </div>
      <% }) %>
    </section>
    <% } %>

    <% if (p.education && p.education.length > 0) { %>
    <section>
      <h2>Education</h2>
      <% p.education.forEach(edu => { %>
        <div class="timeline-item">
          <div class="timeline-title"><%= edu.degree %> in <%= edu.field %></div>
          <div class="timeline-subtitle"><%= edu.institution %></div>
          <div class="timeline-date"><%= edu.startDate %> - <%= edu.endDate %></div>
          <div class="timeline-desc"><%= edu.description %></div>
        </div>
      <% }) %>
    </section>
    <% } %>

    <footer>
      <p>© <%= new Date().getFullYear() %> <%= p.personal?.fullName %>. Crafted with Portfolio Maker.</p>
    </footer>
  </div>
</body>
</html>
