{
  "name": "portfolio-maker",
  "version": "1.0.0",
  "description": "Premium Full-Stack Portfolio Maker Application",
  "main": "server/server.js",
  "scripts": {
    "start": "cd server && node server.js",
    "server": "cd server && node server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm install --prefix server && npm install --prefix client && npm run build --prefix client"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["portfolio", "builder", "react", "express", "ejs", "zip", "export"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
